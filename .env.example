# Copy to .env and fill ONE provider key (free tiers work). Never commit .env.
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides
# TAPTRACE_LLM_PROVIDER=groq          # groq | gemini | openai | openrouter
# TAPTRACE_LLM_MODEL=openai/gpt-oss-120b
# TAPTRACE_PRICE_IN_PER_M=0.15        # USD per 1M prompt tokens (cost accounting)
# TAPTRACE_PRICE_OUT_PER_M=0.60       # USD per 1M completion tokens
# TAPTRACE_OFFLINE=1                  # force deterministic mode (no LLM calls)
# TAPTRACE_COLD_BUDGET_S=7.0          # cold-path latency budget
